# Fournisseur LLM utilisé pour la génération de réponse.
# Options : "mistral" (API gratuite avec quota), "openai_compatible" (Ollama en local, etc.)
LLM_PROVIDER=mistral

# Clé API (laisser vide si LLM_PROVIDER=openai_compatible avec Ollama en local)
LLM_API_KEY=

# URL de base pour un endpoint compatible OpenAI (utile pour Ollama : http://localhost:11434/v1)
LLM_BASE_URL=

# Nom du modèle à utiliser
LLM_MODEL=mistral-small-latest

# Taille du modèle Whisper : tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
